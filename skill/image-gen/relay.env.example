# Copy to relay.env (same folder) and fill in. relay.env is read by relay.sh when
# IMAGE_RELAY_URL / IMAGE_RELAY_TOKEN are not already set in the environment.
# Use a dedicated, restricted token (rate_limit, allowed_models, expires) for skills
# uploaded to Claude web/desktop, since the file is bundled with the skill.
IMAGE_RELAY_URL=https://orgir.terran.app
IMAGE_RELAY_TOKEN=imgr_REPLACE_ME
